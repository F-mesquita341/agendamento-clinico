node_modules/

# Qualquer variante de .env fica de fora — inclusive cópias acidentais como
# ".env.bak", ".env antigo" ou ".env copy". A única exceção é o modelo.
.env*
!.env.example
coverage/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
docs/resultados/**/*.tmp

# Dado de pesquisa nunca vai para o Git, nem pseudonimizado. A exportação já
# recusa gravar dentro do repositório; isto é a segunda proteção, para um CSV
# copiado à mão.
*.csv
