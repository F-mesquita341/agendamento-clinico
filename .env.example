# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# Ambiente: development | test | production
NODE_ENV=development
PORTA=3000

# Banco de desenvolvimento (Neon). Formato:
# postgresql://usuario:senha@host.neon.tech/nome_do_banco?sslmode=require
DATABASE_URL=

# Banco de TESTE — obrigatoriamente outro banco.
# A suíte automatizada limpa tabelas a cada rodada.
DATABASE_URL_TESTE=

# Origens permitidas no CORS, separadas por vírgula.
# Em desenvolvimento pode deixar *; em produção, restrinja.
ORIGENS_PERMITIDAS=*

# Minutos que uma reserva não paga sobrevive antes de liberar o horário
RESERVA_MINUTOS=15

# Transporte até o banco:
#   tcp       - padrão, PostgreSQL na porta 5432
#   websocket - driver do Neon na porta 443, para redes que bloqueiam a 5432
TRANSPORTE_BANCO=tcp

# --- Firebase Admin (autenticação) -------------------------------------------
# Use UMA das duas formas.
#
# Desenvolvimento: só o CAMINHO do JSON da conta de serviço. Guarde o arquivo
# fora do repositório e fora de pastas sincronizadas com a nuvem.
GOOGLE_APPLICATION_CREDENTIALS=
#
# Hospedagem (ex.: Render), onde não há arquivo: as três variáveis juntas,
# definidas no painel do provedor — nunca num arquivo versionado.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Mercado Pago (pagamento, SOMENTE sandbox) -------------------------------
# Credencial da CONTA DE TESTE vendedora, criada no painel do Mercado Pago em
# "Contas de teste". Nunca a credencial de uma conta real: o banco recusa
# pagamento fora do sandbox e o webhook ignora pagamento em modo real.
# Sem estas variáveis, fora de produção, POST /consultas/:id/pagamento
# responde 503 — o resto da API funciona normalmente.
MERCADO_PAGO_ACCESS_TOKEN=
#
# Chave que assina os avisos (webhooks). Aparece no painel da aplicação, na
# configuração de Webhooks, depois de informada a URL de notificação.
MERCADO_PAGO_SEGREDO_WEBHOOK=
#
# Endereço público da API, para onde o Mercado Pago manda os avisos. No Render
# não é preciso: a plataforma define RENDER_EXTERNAL_URL.
URL_PUBLICA=
